{
  "nid": "root",
  "op": "Seq",
  "steps": [
    {
      "nid": "count_values",
      "op": "Call",
      "id": "collection.count@1",
      "args": {
        "list": {
          "pull": "values"
        }
      },
      "into": "count"
    },
    {
      "nid": "require_nonempty",
      "op": "Guard",
      "check": "entry",
      "invariant": {
        "fn": "gt",
        "args": [
          {
            "pull": "count"
          },
          {
            "lit": 0
          }
        ]
      },
      "body": {
        "nid": "compute_avg",
        "op": "Seq",
        "steps": [
          {
            "nid": "sum_values",
            "op": "Call",
            "id": "math.sum@1",
            "args": {
              "list": {
                "pull": "values"
              }
            },
            "into": "sum"
          },
          {
            "nid": "divide",
            "op": "Call",
            "id": "math.divide@1",
            "args": {
              "a": {
                "pull": "sum"
              },
              "b": {
                "pull": "count"
              }
            },
            "into": "average"
          }
        ]
      },
      "on_violation": {
        "nid": "empty_error",
        "op": "Call",
        "id": "express.say@1",
        "args": {
          "text": {
            "lit": "Math.EmptyInput"
          }
        },
        "into": "error"
      }
    }
  ]
}
