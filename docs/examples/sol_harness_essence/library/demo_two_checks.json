{
  "id": "demo.two_checks",
  "summary": "Invoke demo.sum_ok twice (2+3 and 2+2), then report both replies",
  "program": {
    "nid": "root",
    "op": "Seq",
    "steps": [
      {
        "nid": "check_ok",
        "op": "Call",
        "id": "harness.invoke@1",
        "args": {
          "id": { "lit": "demo.sum_ok" },
          "x": { "lit": 2 },
          "y": { "lit": 3 }
        },
        "into": "first"
      },
      {
        "nid": "check_nope",
        "op": "Call",
        "id": "harness.invoke@1",
        "args": {
          "id": { "lit": "demo.sum_ok" },
          "x": { "lit": 2 },
          "y": { "lit": 2 }
        },
        "into": "second"
      },
      {
        "nid": "report",
        "op": "Call",
        "id": "express.say@1",
        "args": {
          "text": {
            "fn": "concat",
            "args": [
              { "lit": "first=" },
              { "pull": "first.reply.text" },
              { "lit": " second=" },
              { "pull": "second.reply.text" }
            ]
          }
        },
        "into": "out"
      }
    ]
  }
}
