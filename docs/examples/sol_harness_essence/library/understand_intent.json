{
  "id": "understand_intent",
  "program": {
    "nid": "root",
    "op": "Seq",
    "steps": [
      {
        "args": {
          "text": {
            "pull": "utterance"
          }
        },
        "id": "understand.classify@1",
        "into": "intent",
        "nid": "classify",
        "op": "Call"
      },
      {
        "args": {
          "text": {
            "args": [
              {
                "lit": "Intent label="
              },
              {
                "pull": "intent.label"
              }
            ],
            "fn": "concat"
          }
        },
        "id": "express.say@1",
        "into": "out",
        "nid": "say",
        "op": "Call"
      }
    ]
  },
  "summary": "Clarify what the user wants; suggest the next harness; may ask one question"
}
