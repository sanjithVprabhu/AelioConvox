          "op": "Call"
        },
        "max_iter": 5,
        "nid": "loop",
        "op": "Loop",
        "while": {
          "args": [
            {
              "pull": "n"
            },
            {
              "lit": 3
            }
          ],
          "fn": "lt"
        }
      },
      {
        "args": {
          "text": {
            "lit": "repeat-add done"
          }
        },
        "id": "express.say@1",
        "into": "msg",
        "nid": "say",
        "op": "Call"
      }
    ]
  },
  "summary": "Deterministic repeat: Loop adds 1 to n three times (control Loop)"
}
