{
  "id": "calc_repeat_add",
  "program": {
    "nid": "root",
    "op": "Seq",
    "steps": [
      {
        "nid": "seed",
        "op": "Const",
        "v": {
          "n": 0
        }
      },
      {
        "body": {
          "args": {
            "v": {
              "args": [
                {
                  "pull": "n"
                },
                {
                  "lit": 1
                }
              ],
              "fn": "add"
            }
          },
          "id": "compute.hold@1",
          "into": "n",
