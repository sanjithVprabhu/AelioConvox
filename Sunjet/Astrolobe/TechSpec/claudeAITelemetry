  ├── MultiFileTextSearch (cost=420.0 actual=380.2ms rows=60)
  │     column=body, query="derivatives"
  │     files_scanned=42, files_pruned=158 (bloom filter)
  │     posting_list_decode_bytes=4.2MB
  │     buffer_pool_hits=98.5%
