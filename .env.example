AELIO_SDK_SECRET=change-me-in-production
AELIO_PORT=3010
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=your_key_here
GEMINI_API_KEY=your_gemini_key_here
GROQ_API_KEY=your_key_here
VOYAGE_API_KEY=your_voyage_key_here
AELIO_CONFIG=./config.yaml

# Harness authority (Rust /v1/turns):
#   agent_loop — default under `pnpm start`; provider-native model → tool → result loop
#   auto   — compatibility selection used by direct/test runtime construction
#   legacy — explicit rollback to the keyword Conductor / agent spine
#   sol    — force Sol Path B cutovers (conductor.root + tool harnesses)
# AELIO_HARNESS_MODE=agent_loop
# AELIO_AGENT_LOOP_GATEWAY_URL=http://127.0.0.1:3000/internal/aelio/llm/agent
# AELIO_AGENT_LOOP_STATE_KEY=<32-byte base64url key; keep stable across restarts>
# AELIO_SKIP_EXAMPLE_SDK=1
