# Local/dev placeholder only. Production refuses to start if this value is used.
AELIO_SDK_SECRET=change-me-in-production
# Production web embeds: comma-separated origins (no "*"). Example:
# AELIO_ALLOWED_ORIGINS=https://app.example.com,https://www.example.com
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=your_key_here
GEMINI_API_KEY=your_gemini_key_here
GROQ_API_KEY=your_key_here
VOYAGE_API_KEY=your_voyage_key_here
# OpenAI (recommended): config.openai.yaml | Mock/local: config.yaml
AELIO_CONFIG=./config.openai.yaml
