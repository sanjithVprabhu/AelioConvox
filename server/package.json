{
  "name": "@aelio/server",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsup src/main.ts --format esm",
    "dev": "tsx watch src/main.ts",
    "dev:once": "tsx src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aelio/channels": "workspace:*",
    "@aelio/core": "workspace:*",
    "@aelio/llm": "workspace:*",
    "@aelio/protocol": "workspace:*",
    "@aelio/sunjet-client": "workspace:*",
    "@fastify/static": "^8.2.0",
    "@fastify/websocket": "^11.1.0",
    "fastify": "^5.4.0",
    "pino": "^9.7.0",
    "yaml": "^2.8.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}